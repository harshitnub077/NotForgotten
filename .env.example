# ── LLM (optional — every feature has an offline fallback) ──
# Pick one provider and set its key. If LLM_PROVIDER is unset, the first key found is used.
LLM_PROVIDER=groq                 # groq | openai | anthropic
LLM_MODEL=openai/gpt-oss-120b      # e.g. gpt-4o-mini, claude-sonnet-5-5
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Storage ──────────────────────────────────────────
# Hosted Postgres (Neon, Supabase, Render…). Leave unset to use local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_PATH=./data/memory.db
HF_HOME=./data/hf_cache
SENTENCE_TRANSFORMERS_HOME=./data/hf_cache

# ── Server & accounts ────────────────────────────────
CORS_ORIGINS=http://localhost:5173
# COOKIE_SECURE=1                 # set in production (HTTPS)
# BETA_INVITE_CODES=JEE2026,NEETBETA  # require an invite code to sign up
# NOTFORGOTTEN_OFFLINE=1          # force offline mode (no LLM calls)
